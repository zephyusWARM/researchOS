{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "researchOS Claim Revision",
  "type": "object",
  "required": [
    "id",
    "claim_key",
    "revision",
    "statement",
    "status",
    "evidence_ids",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^claim-"
    },
    "claim_key": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "proposed",
        "supported",
        "disputed",
        "retired"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ev-"
      },
      "uniqueItems": true
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
