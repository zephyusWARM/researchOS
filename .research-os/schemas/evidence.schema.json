{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "researchOS Evidence",
  "type": "object",
  "required": [
    "id",
    "source_id",
    "statement",
    "locator",
    "captured_at",
    "evidence_type"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ev-"
    },
    "source_id": {
      "type": "string",
      "pattern": "^src-"
    },
    "evidence_type": {
      "enum": [
        "quote",
        "paraphrase",
        "data",
        "metadata",
        "observation"
      ]
    },
    "locator": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
