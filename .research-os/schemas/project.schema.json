{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "researchOS Project",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "cutoff_date",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^project-"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "complete",
        "archived"
      ]
    },
    "cutoff_date": {
      "type": "string",
      "format": "date"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": true
}
