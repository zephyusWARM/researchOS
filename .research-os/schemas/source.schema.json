{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "researchOS Source",
  "type": "object",
  "required": [
    "id",
    "title",
    "source_type",
    "locator",
    "captured_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^src-"
    },
    "locator": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
