{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "researchOS Task",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "question",
    "created_at",
    "max_active_runs"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^task-"
    },
    "status": {
      "enum": [
        "open",
        "active",
        "blocked",
        "done",
        "cancelled"
      ]
    },
    "max_active_runs": {
      "type": "integer",
      "minimum": 1
    },
    "parent_task_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
